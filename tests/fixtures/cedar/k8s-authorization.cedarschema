namespace k8s {
  entity Group = {
    "name": __cedar::String
  };

  entity User in [Group] = {
    "name": __cedar::String
  };

  entity ServiceAccount in [Group] = {
    "name": __cedar::String,
    "namespace": __cedar::String
  };

  entity Node in [Group] = {
    "name": __cedar::String
  };

  entity Resource = {
    "apiGroup": __cedar::String,
    "name"?: __cedar::String,
    "namespace"?: __cedar::String,
    "resource": __cedar::String,
    "subresource"?: __cedar::String
  };

  action "get" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };

  action "list" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };

  action "watch" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };

  action "create" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };

  action "update" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };

  action "patch" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };

  action "delete" appliesTo {
    principal: [Group, Node, ServiceAccount, User],
    resource: [Resource],
    context: {}
  };
}
